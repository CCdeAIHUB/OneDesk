<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OneDesk</AssemblyName>
    <RootNamespace>OneDesk.Windows</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\desktop\Domain\*.cs" LinkBase="Domain" />
    <Compile Include="..\desktop\Storage\*.cs" LinkBase="Storage" />
    <Compile Include="..\desktop\Services\*.cs" LinkBase="Services" />
    <Compile Include="..\desktop\Transport\*.cs" LinkBase="Transport" />
    <Compile Include="..\desktop\Protocol\*.cs" LinkBase="Protocol" />
    <Compile Include="..\desktop\Shell\BridgeContracts.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\DesktopBridgeDispatcher.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\DesktopBridgeDispatcher.Devices.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\DesktopBridgeDispatcher.Imports.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\DesktopBridgeDispatcher.Plugins.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\DesktopBridgeDispatcher.Workspace.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\IDesktopShellPlatform.cs" LinkBase="Shell" />
    <Compile Include="..\desktop\Shell\PortableDesktopSettingsService.cs" LinkBase="Shell" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\frontends\desktop\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <!-- WebView2 包会同时注入 WPF 和 WinForms 引用；本项目只使用 WinForms，移除 WPF 可避免 WindowsBase 版本冲突。 -->
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
