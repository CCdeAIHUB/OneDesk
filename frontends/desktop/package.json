{
  "name": "@onedesk/desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "generate:icons": "node ../../scripts/generate-icon-subset.mjs src src/generatedIconCollections.ts solar fluent",
    "build": "pnpm generate:icons && vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@iconify-json/fluent": "^1.2.51",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/types": "latest",
    "@iconify/vue": "latest",
    "@onedesk/protocol": "workspace:*",
    "@tailwindcss/vite": "latest",
    "@vue/compiler-sfc": "3.5.40",
    "codemirror": "^6.0.2",
    "esbuild-wasm": "0.28.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
