{
  "name": "@onedesk/mobile-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "generate:icons": "node ../../scripts/generate-icon-subset.mjs src src/generatedIconCollections.ts solar",
    "build": "pnpm generate:icons && vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@iconify/types": "latest",
    "@iconify/vue": "latest",
    "@onedesk/protocol": "workspace:*",
    "@tailwindcss/vite": "latest",
    "tailwindcss": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
